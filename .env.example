# PowerTrader2 Environment Configuration
# Copy this file to .env and customize the values
# NOTE: Most settings have sensible defaults and don't need to be changed

# =============================================================================
# Security Settings
# =============================================================================

# Enable credential encryption (recommended)
# When true, API credentials are stored in OS keyring
# When false, falls back to plaintext r_key.txt and r_secret.txt files
CREDENTIALS_ENCRYPTION_ENABLED=true

# Enable TOTP 2FA for GUI access (optional, not yet implemented)
# TOTP_2FA_ENABLED=false

# =============================================================================
# API Rate Limiting
# =============================================================================

# Maximum API calls per minute (Robinhood limit)
# Recommended: 60 (default)
# Lower this if you experience rate limiting
API_MAX_CALLS_PER_MINUTE=60

# Maximum retry attempts for failed API calls
# Default: 5
API_BACKOFF_MAX_RETRIES=5

# Initial backoff delay in seconds
# Doubles on each retry: 1s → 2s → 4s → 8s → 16s
API_BACKOFF_INITIAL_DELAY=1.0

# =============================================================================
# Cache Settings
# =============================================================================

# Price cache time-to-live in seconds
# How long to keep cached price data before considering it stale
# Recommended: 5 (default)
# Increase if you experience frequent API failures
PRICE_CACHE_TTL_SECONDS=5

# Account cache time-to-live in seconds
# How long to keep cached account data
# Recommended: 10 (default)
ACCOUNT_CACHE_TTL_SECONDS=10

# =============================================================================
# Monitoring Settings
# =============================================================================

# Prometheus metrics export port
# Access metrics at http://localhost:{METRICS_PORT}/metrics
# Default: 8000
METRICS_PORT=8000

# Health check endpoint port
# Access health check at http://localhost:{HEALTH_CHECK_PORT}/health
# Default: 8080
HEALTH_CHECK_PORT=8080

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Recommended: INFO for production, DEBUG for troubleshooting
LOG_LEVEL=INFO

# Log directory
# Where to store log files
# Default: logs/
LOG_DIR=logs

# Enable JSON-formatted logs
# When true, logs are output in JSON format for easier parsing
# Default: false
LOG_JSON_FORMAT=false

# =============================================================================
# Reliability Settings
# =============================================================================

# Order reconciliation timeout in seconds
# Maximum time to wait for pending orders to resolve
# Default: 300 (5 minutes)
ORDER_RECONCILIATION_TIMEOUT_SECONDS=300

# Maximum retries for order reconciliation
# How many times to retry checking pending orders
# Default: 10
ORDER_RECONCILIATION_MAX_RETRIES=10

# Stuck order alert webhook URL (optional)
# Set to your Slack webhook URL to receive alerts for stuck orders
# Leave empty to disable webhook alerts
# Example: https://hooks.slack.com/services/YOUR/WEBHOOK/URL
STUCK_ORDER_ALERT_WEBHOOK=

# =============================================================================
# File Integrity Settings
# =============================================================================

# Enable model file integrity checks
# When true, verifies model files haven't been tampered with
# Recommended: true (default)
ENABLE_INTEGRITY_CHECKS=true

# Checksum file name
# Name of the file storing model checksums
# Default: model_checksums.json
CHECKSUM_FILE=model_checksums.json

# =============================================================================
# Trading Settings (from gui_settings.json, can be overridden here)
# =============================================================================

# These settings are typically configured via the GUI
# but can be overridden here for automation/testing

# Default trade start level (neural levels to trigger)
# TRADE_START_LEVEL=3

# Starting allocation percentage
# START_ALLOCATION_PCT=0.005

# DCA multiplier
# DCA_MULTIPLIER=2.0

# Maximum DCA buys per 24 hours (per coin)
# MAX_DCA_BUYS_PER_24H=2

# =============================================================================
# Development/Testing Settings
# =============================================================================

# Enable paper trading mode (not yet implemented)
# When true, simulates trades without real money
# PAPER_TRADING=false

# Enable debug mode
# Increases verbosity and disables some safety checks
# DEBUG_MODE=false

# =============================================================================
# Notes
# =============================================================================

# - Lines starting with # are comments
# - Empty values use defaults
# - Most settings have sensible defaults
# - Changes require restarting the trader
# - For GUI settings, prefer using the Settings panel
# - Keep this file secure - do not commit with real values
